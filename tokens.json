{
  "global": {
    "color": {
      "ink": { "$type": "color", "$value": "#18181B" },
      "success": { "500": { "$type": "color", "$value": "#10B981" } },
      "warning": { "500": { "$type": "color", "$value": "#F59E0B" } },
      "danger": { "500": { "$type": "color", "$value": "#F43F5E" } },
      "white": { "$type": "color", "$value": "#ffffff" },
      "phase": {
        "concept": { "$type": "color", "$value": "#a78bfa" },
        "world_bible": { "$type": "color", "$value": "#60a5fa" },
        "character_vault": { "$type": "color", "$value": "#34d399" },
        "synopsis": { "$type": "color", "$value": "#eab308" },
        "treatment": { "$type": "color", "$value": "#f472b6" },
        "outline": { "$type": "color", "$value": "#fb923c" },
        "first_draft": { "$type": "color", "$value": "#22d3ee" },
        "revision": { "$type": "color", "$value": "#a78bfa" },
        "final_draft": { "$type": "color", "$value": "#34d399" }
      },
      "scrim": {
        "subtle": { "$type": "color", "$value": "rgba(0, 0, 0, 0.4)" },
        "default": { "$type": "color", "$value": "rgba(0, 0, 0, 0.7)" },
        "strong": { "$type": "color", "$value": "rgba(0, 0, 0, 0.9)" }
      }
    },
    "space": {
      "1": { "$type": "spacing", "$value": "4" },
      "1.5": { "$type": "spacing", "$value": "6" },
      "2": { "$type": "spacing", "$value": "8" },
      "2.5": { "$type": "spacing", "$value": "10" },
      "3": { "$type": "spacing", "$value": "12" },
      "4": { "$type": "spacing", "$value": "16" },
      "5": { "$type": "spacing", "$value": "20" },
      "6": { "$type": "spacing", "$value": "24" },
      "8": { "$type": "spacing", "$value": "32" },
      "10": { "$type": "spacing", "$value": "40" },
      "12": { "$type": "spacing", "$value": "48" }
    },
    "radius": {
      "sm": { "$type": "borderRadius", "$value": "6" },
      "md": { "$type": "borderRadius", "$value": "8" },
      "lg": { "$type": "borderRadius", "$value": "12" },
      "full": { "$type": "borderRadius", "$value": "9999" }
    },
    "fontFamily": {
      "sans": { "$type": "fontFamilies", "$value": "Outfit, sans-serif" }
    },
    "fontSize": {
      "xs": { "$type": "fontSizes", "$value": "12" },
      "sm": { "$type": "fontSizes", "$value": "14" },
      "base": { "$type": "fontSizes", "$value": "16" },
      "lg": { "$type": "fontSizes", "$value": "18" },
      "xl": { "$type": "fontSizes", "$value": "20" },
      "2xl": { "$type": "fontSizes", "$value": "24" },
      "3xl": { "$type": "fontSizes", "$value": "30" }
    },
    "fontWeight": {
      "normal": { "$type": "fontWeights", "$value": "400" },
      "medium": { "$type": "fontWeights", "$value": "500" },
      "semibold": { "$type": "fontWeights", "$value": "600" },
      "bold": { "$type": "fontWeights", "$value": "700" },
      "black": { "$type": "fontWeights", "$value": "900" }
    },
    "lineHeight": {
      "tight": { "$type": "lineHeights", "$value": "125%" },
      "snug": { "$type": "lineHeights", "$value": "137.5%" },
      "normal": { "$type": "lineHeights", "$value": "150%" },
      "relaxed": { "$type": "lineHeights", "$value": "162.5%" }
    },
    "shadow": {
      "sm": {
        "$type": "boxShadow",
        "$value": { "x": "0", "y": "1", "blur": "2", "spread": "0", "color": "rgba(16, 24, 40, 0.05)", "type": "dropShadow" }
      },
      "md": {
        "$type": "boxShadow",
        "$value": { "x": "0", "y": "12.5", "blur": "40", "spread": "-6", "color": "rgba(28, 34, 43, 0.1)", "type": "dropShadow" }
      },
      "lg": {
        "$type": "boxShadow",
        "$value": { "x": "0", "y": "25", "blur": "80", "spread": "-12", "color": "rgba(28, 34, 43, 0.1)", "type": "dropShadow" }
      }
    },
    "breakpoint": {
      "mobile": { "$type": "sizing", "$value": "0" },
      "tablet": { "$type": "sizing", "$value": "768" },
      "web": { "$type": "sizing", "$value": "1440" }
    }
  },
  "theme-light": {
    "color": {
      "surface": {
        "bg": { "$type": "color", "$value": "#f0f1f3" },
        "default": { "$type": "color", "$value": "#ffffff" },
        "raised": { "$type": "color", "$value": "#f2f3f5" },
        "border": { "$type": "color", "$value": "#dcdce1" },
        "border-strong": { "$type": "color", "$value": "#cbccd2" },
        "overlay": { "$type": "color", "$value": "#ffffff" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "#18181b" },
        "muted": { "$type": "color", "$value": "#52525b" }
      },
      "brand": {
        "primary": { "$type": "color", "$value": "#BC2566" },
        "primary-hover": { "$type": "color", "$value": "#A01F57" },
        "text": { "$type": "color", "$value": "#BC2566" },
        "tint-10": { "$type": "color", "$value": "rgba(188, 37, 102, 0.1)" },
        "tint-15": { "$type": "color", "$value": "rgba(188, 37, 102, 0.15)" },
        "tint-30": { "$type": "color", "$value": "rgba(188, 37, 102, 0.3)" },
        "tint-40": { "$type": "color", "$value": "rgba(188, 37, 102, 0.4)" }
      }
    }
  },
  "theme-dark": {
    "color": {
      "surface": {
        "bg": { "$type": "color", "$value": "#0a0a0a" },
        "default": { "$type": "color", "$value": "#17171a" },
        "raised": { "$type": "color", "$value": "#1f1f22" },
        "border": { "$type": "color", "$value": "#262626" },
        "border-strong": { "$type": "color", "$value": "#3a3a3a" },
        "overlay": { "$type": "color", "$value": "#17171a" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "#ffffff" },
        "muted": { "$type": "color", "$value": "#9ca3af" }
      },
      "brand": {
        "primary": { "$type": "color", "$value": "#BE3A6B" },
        "primary-hover": { "$type": "color", "$value": "#A1315B" },
        "text": { "$type": "color", "$value": "#DB8FA8" },
        "tint-10": { "$type": "color", "$value": "rgba(190, 58, 107, 0.1)" },
        "tint-15": { "$type": "color", "$value": "rgba(190, 58, 107, 0.15)" },
        "tint-30": { "$type": "color", "$value": "rgba(190, 58, 107, 0.3)" },
        "tint-40": { "$type": "color", "$value": "rgba(190, 58, 107, 0.4)" }
      }
    }
  },
  "bp-mobile": {
    "layout": {
      "grid": {
        "columns": { "$type": "number", "$value": "4" },
        "gutter": { "$type": "spacing", "$value": "{space.4}" },
        "margin": { "$type": "spacing", "$value": "{space.4}" }
      }
    },
    "typography": {
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.bold}",
          "fontSize": "{fontSize.xl}",
          "lineHeight": "{lineHeight.tight}"
        }
      }
    }
  },
  "bp-tablet": {
    "layout": {
      "grid": {
        "columns": { "$type": "number", "$value": "8" },
        "gutter": { "$type": "spacing", "$value": "{space.6}" },
        "margin": { "$type": "spacing", "$value": "{space.6}" }
      }
    },
    "typography": {
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.bold}",
          "fontSize": "{fontSize.2xl}",
          "lineHeight": "{lineHeight.tight}"
        }
      }
    }
  },
  "bp-web": {
    "layout": {
      "grid": {
        "columns": { "$type": "number", "$value": "12" },
        "gutter": { "$type": "spacing", "$value": "{space.6}" },
        "margin": { "$type": "spacing", "$value": "{space.12}" }
      }
    },
    "typography": {
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.bold}",
          "fontSize": "{fontSize.3xl}",
          "lineHeight": "{lineHeight.tight}"
        }
      }
    }
  },
  "semantic": {
    "typography": {
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.semibold}",
          "fontSize": "{fontSize.sm}",
          "lineHeight": "{lineHeight.normal}"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.normal}",
          "fontSize": "{fontSize.sm}",
          "lineHeight": "{lineHeight.normal}"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.normal}",
          "fontSize": "{fontSize.xs}",
          "lineHeight": "{lineHeight.normal}"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.semibold}",
          "fontSize": "{fontSize.xs}",
          "lineHeight": "{lineHeight.normal}"
        }
      }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.text.primary}" },
      "secondary": { "$type": "color", "$value": "{color.text.muted}" },
      "inverse": { "$type": "color", "$value": "{color.ink}" }
    },
    "surface": {
      "default": { "$type": "color", "$value": "{color.surface.default}" },
      "muted": { "$type": "color", "$value": "{color.surface.raised}" },
      "border": { "$type": "color", "$value": "{color.surface.border}" },
      "overlay": { "$type": "color", "$value": "{color.surface.overlay}" },
      "scrim": { "$type": "color", "$value": "{color.scrim.default}" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{color.brand.primary}" },
      "primary-hover": { "$type": "color", "$value": "{color.brand.primary-hover}" },
      "text": { "$type": "color", "$value": "{color.brand.text}" }
    },
    "feedback": {
      "success": { "$type": "color", "$value": "{color.success.500}" },
      "warning": { "$type": "color", "$value": "{color.warning.500}" },
      "danger": { "$type": "color", "$value": "{color.danger.500}" }
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": { "$type": "color", "$value": "{action.primary}" },
        "bg-hover": { "$type": "color", "$value": "{action.primary-hover}" },
        "fg": { "$type": "color", "$value": "{color.white}" },
        "radius": { "$type": "borderRadius", "$value": "{radius.md}" }
      }
    },
    "badge": {
      "success": {
        "bg": { "$type": "color", "$value": "{feedback.success}" },
        "fg": { "$type": "color", "$value": "{text.inverse}" }
      },
      "warning": {
        "bg": { "$type": "color", "$value": "{feedback.warning}" },
        "fg": { "$type": "color", "$value": "{text.inverse}" }
      },
      "danger": {
        "bg": { "$type": "color", "$value": "{feedback.danger}" },
        "fg": { "$type": "color", "$value": "{text.inverse}" }
      }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{surface.default}" },
      "border": { "$type": "color", "$value": "{surface.border}" },
      "radius": { "$type": "borderRadius", "$value": "{radius.lg}" }
    },
    "phaseTag": {
      "concept": { "bg": { "$type": "color", "$value": "{color.phase.concept}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "world_bible": { "bg": { "$type": "color", "$value": "{color.phase.world_bible}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "character_vault": { "bg": { "$type": "color", "$value": "{color.phase.character_vault}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "synopsis": { "bg": { "$type": "color", "$value": "{color.phase.synopsis}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "treatment": { "bg": { "$type": "color", "$value": "{color.phase.treatment}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "outline": { "bg": { "$type": "color", "$value": "{color.phase.outline}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "first_draft": { "bg": { "$type": "color", "$value": "{color.phase.first_draft}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "revision": { "bg": { "$type": "color", "$value": "{color.phase.revision}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "final_draft": { "bg": { "$type": "color", "$value": "{color.phase.final_draft}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } }
    },
    "stateBadge": {
      "idle": { "bg": { "$type": "color", "$value": "{surface.border}" }, "fg": { "$type": "color", "$value": "{text.primary}" } },
      "generating": { "bg": { "$type": "color", "$value": "{action.primary}" }, "fg": { "$type": "color", "$value": "{color.white}" } },
      "polling": { "bg": { "$type": "color", "$value": "{color.phase.world_bible}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "pending_qa": { "bg": { "$type": "color", "$value": "{feedback.warning}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "approved": { "bg": { "$type": "color", "$value": "{feedback.success}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "killed": { "bg": { "$type": "color", "$value": "{feedback.danger}" }, "fg": { "$type": "color", "$value": "{color.white}" } },
      "failed": { "bg": { "$type": "color", "$value": "{feedback.danger}" }, "fg": { "$type": "color", "$value": "{color.white}" } }
    }
  },
  "$metadata": {
    "tokenSetOrder": [
      "global",
      "theme-light",
      "theme-dark",
      "bp-mobile",
      "bp-tablet",
      "bp-web",
      "semantic",
      "component"
    ]
  },
  "$themes": [
    {
      "id": "scriptoplay-light",
      "name": "Light",
      "group": "Theme",
      "selectedTokenSets": {
        "global": "source",
        "theme-light": "enabled",
        "theme-dark": "disabled",
        "bp-mobile": "enabled",
        "bp-tablet": "disabled",
        "bp-web": "disabled",
        "semantic": "enabled",
        "component": "enabled"
      }
    },
    {
      "id": "scriptoplay-dark",
      "name": "Dark",
      "group": "Theme",
      "selectedTokenSets": {
        "global": "source",
        "theme-light": "disabled",
        "theme-dark": "enabled",
        "bp-mobile": "enabled",
        "bp-tablet": "disabled",
        "bp-web": "disabled",
        "semantic": "enabled",
        "component": "enabled"
      }
    },
    {
      "id": "scriptoplay-mobile",
      "name": "Mobile",
      "group": "Breakpoint",
      "selectedTokenSets": {
        "global": "source",
        "theme-light": "enabled",
        "theme-dark": "disabled",
        "bp-mobile": "enabled",
        "bp-tablet": "disabled",
        "bp-web": "disabled",
        "semantic": "enabled",
        "component": "enabled"
      }
    },
    {
      "id": "scriptoplay-tablet",
      "name": "Tablet",
      "group": "Breakpoint",
      "selectedTokenSets": {
        "global": "source",
        "theme-light": "enabled",
        "theme-dark": "disabled",
        "bp-mobile": "disabled",
        "bp-tablet": "enabled",
        "bp-web": "disabled",
        "semantic": "enabled",
        "component": "enabled"
      }
    },
    {
      "id": "scriptoplay-web",
      "name": "Web",
      "group": "Breakpoint",
      "selectedTokenSets": {
        "global": "source",
        "theme-light": "enabled",
        "theme-dark": "disabled",
        "bp-mobile": "disabled",
        "bp-tablet": "disabled",
        "bp-web": "enabled",
        "semantic": "enabled",
        "component": "enabled"
      }
    }
  ]
}
