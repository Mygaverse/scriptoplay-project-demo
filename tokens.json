{
  "global": {
    "color": {
      "brand": {
        "primary": { "$type": "color", "$value": "#BE3A6B" },
        "primary-dark": { "$type": "color", "$value": "#A1315B" },
        "ink": { "$type": "color", "$value": "#18181B" }
      },
      "grey": {
        "bg": { "$type": "color", "$value": "#0A0A0A" },
        "surface": { "$type": "color", "$value": "#17171A" },
        "surface-raised": { "$type": "color", "$value": "#1F1F22" },
        "border": { "$type": "color", "$value": "#262626" },
        "border-strong": { "$type": "color", "$value": "#3A3A3A" },
        "text": { "$type": "color", "$value": "#FFFFFF" },
        "text-muted": { "$type": "color", "$value": "#9CA3AF" }
      },
      "success": { "500": { "$type": "color", "$value": "#10B981" } },
      "warning": { "500": { "$type": "color", "$value": "#F59E0B" } },
      "danger": { "500": { "$type": "color", "$value": "#F43F5E" } },
      "white": { "$type": "color", "$value": "#ffffff" },
      "phase": {
        "concept": { "$type": "color", "$value": "#a78bfa" },
        "world_bible": { "$type": "color", "$value": "#60a5fa" },
        "character_vault": { "$type": "color", "$value": "#34d399" },
        "synopsis": { "$type": "color", "$value": "#eab308" },
        "treatment": { "$type": "color", "$value": "#f472b6" },
        "outline": { "$type": "color", "$value": "#fb923c" },
        "first_draft": { "$type": "color", "$value": "#22d3ee" },
        "revision": { "$type": "color", "$value": "#a78bfa" },
        "final_draft": { "$type": "color", "$value": "#34d399" }
      }
    },
    "space": {
      "1": { "$type": "spacing", "$value": "4" },
      "1.5": { "$type": "spacing", "$value": "6" },
      "2": { "$type": "spacing", "$value": "8" },
      "2.5": { "$type": "spacing", "$value": "10" },
      "3": { "$type": "spacing", "$value": "12" },
      "4": { "$type": "spacing", "$value": "16" },
      "5": { "$type": "spacing", "$value": "20" },
      "6": { "$type": "spacing", "$value": "24" },
      "8": { "$type": "spacing", "$value": "32" },
      "10": { "$type": "spacing", "$value": "40" },
      "12": { "$type": "spacing", "$value": "48" }
    },
    "radius": {
      "sm": { "$type": "borderRadius", "$value": "6" },
      "md": { "$type": "borderRadius", "$value": "8" },
      "lg": { "$type": "borderRadius", "$value": "12" },
      "full": { "$type": "borderRadius", "$value": "9999" }
    },
    "fontFamily": {
      "sans": { "$type": "fontFamilies", "$value": "Outfit" }
    },
    "fontSize": {
      "xs": { "$type": "fontSizes", "$value": "12" },
      "sm": { "$type": "fontSizes", "$value": "14" },
      "base": { "$type": "fontSizes", "$value": "16" },
      "lg": { "$type": "fontSizes", "$value": "18" },
      "xl": { "$type": "fontSizes", "$value": "20" },
      "2xl": { "$type": "fontSizes", "$value": "24" }
    },
    "fontWeight": {
      "normal": { "$type": "fontWeights", "$value": "400" },
      "medium": { "$type": "fontWeights", "$value": "500" },
      "semibold": { "$type": "fontWeights", "$value": "600" },
      "bold": { "$type": "fontWeights", "$value": "700" },
      "black": { "$type": "fontWeights", "$value": "900" }
    },
    "lineHeight": {
      "tight": { "$type": "lineHeights", "$value": "125%" },
      "snug": { "$type": "lineHeights", "$value": "137.5%" },
      "normal": { "$type": "lineHeights", "$value": "150%" },
      "relaxed": { "$type": "lineHeights", "$value": "162.5%" }
    },
    "shadow": {
      "sm": {
        "$type": "boxShadow",
        "$value": { "x": "0", "y": "1", "blur": "2", "spread": "0", "color": "rgba(16, 24, 40, 0.05)", "type": "dropShadow" }
      },
      "md": {
        "$type": "boxShadow",
        "$value": { "x": "0", "y": "12.5", "blur": "40", "spread": "-6", "color": "rgba(28, 34, 43, 0.1)", "type": "dropShadow" }
      },
      "lg": {
        "$type": "boxShadow",
        "$value": { "x": "0", "y": "25", "blur": "80", "spread": "-12", "color": "rgba(28, 34, 43, 0.1)", "type": "dropShadow" }
      }
    }
  },
  "semantic": {
    "text": {
      "primary": { "$type": "color", "$value": "{color.grey.text}" },
      "secondary": { "$type": "color", "$value": "{color.grey.text-muted}" },
      "inverse": { "$type": "color", "$value": "{color.brand.ink}" }
    },
    "surface": {
      "default": { "$type": "color", "$value": "{color.grey.surface}" },
      "muted": { "$type": "color", "$value": "{color.grey.surface-raised}" },
      "border": { "$type": "color", "$value": "{color.grey.border}" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{color.brand.primary}" },
      "primary-hover": { "$type": "color", "$value": "{color.brand.primary-dark}" }
    },
    "feedback": {
      "success": { "$type": "color", "$value": "{color.success.500}" },
      "warning": { "$type": "color", "$value": "{color.warning.500}" },
      "danger": { "$type": "color", "$value": "{color.danger.500}" }
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": { "$type": "color", "$value": "{action.primary}" },
        "bg-hover": { "$type": "color", "$value": "{action.primary-hover}" },
        "fg": { "$type": "color", "$value": "{color.white}" },
        "radius": { "$type": "borderRadius", "$value": "{radius.md}" }
      }
    },
    "badge": {
      "success": {
        "bg": { "$type": "color", "$value": "{feedback.success}" },
        "fg": { "$type": "color", "$value": "{text.inverse}" }
      },
      "warning": {
        "bg": { "$type": "color", "$value": "{feedback.warning}" },
        "fg": { "$type": "color", "$value": "{text.inverse}" }
      },
      "danger": {
        "bg": { "$type": "color", "$value": "{feedback.danger}" },
        "fg": { "$type": "color", "$value": "{text.inverse}" }
      }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{surface.default}" },
      "border": { "$type": "color", "$value": "{surface.border}" },
      "radius": { "$type": "borderRadius", "$value": "{radius.lg}" }
    },
    "phaseTag": {
      "concept": { "bg": { "$type": "color", "$value": "{color.phase.concept}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "world_bible": { "bg": { "$type": "color", "$value": "{color.phase.world_bible}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "character_vault": { "bg": { "$type": "color", "$value": "{color.phase.character_vault}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "synopsis": { "bg": { "$type": "color", "$value": "{color.phase.synopsis}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "treatment": { "bg": { "$type": "color", "$value": "{color.phase.treatment}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "outline": { "bg": { "$type": "color", "$value": "{color.phase.outline}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "first_draft": { "bg": { "$type": "color", "$value": "{color.phase.first_draft}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "revision": { "bg": { "$type": "color", "$value": "{color.phase.revision}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "final_draft": { "bg": { "$type": "color", "$value": "{color.phase.final_draft}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } }
    },
    "stateBadge": {
      "idle": { "bg": { "$type": "color", "$value": "{surface.border}" }, "fg": { "$type": "color", "$value": "{text.primary}" } },
      "generating": { "bg": { "$type": "color", "$value": "{action.primary}" }, "fg": { "$type": "color", "$value": "{color.white}" } },
      "polling": { "bg": { "$type": "color", "$value": "{color.phase.world_bible}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "pending_qa": { "bg": { "$type": "color", "$value": "{feedback.warning}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "approved": { "bg": { "$type": "color", "$value": "{feedback.success}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "killed": { "bg": { "$type": "color", "$value": "{feedback.danger}" }, "fg": { "$type": "color", "$value": "{color.white}" } },
      "failed": { "bg": { "$type": "color", "$value": "{feedback.danger}" }, "fg": { "$type": "color", "$value": "{color.white}" } }
    }
  },
  "$metadata": {
    "tokenSetOrder": ["global", "semantic", "component"]
  },
  "$themes": [
    {
      "id": "scriptoplay-default",
      "name": "Default",
      "selectedTokenSets": {
        "global": "source",
        "semantic": "enabled",
        "component": "enabled"
      }
    }
  ]
}
