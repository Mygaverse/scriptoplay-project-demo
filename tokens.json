{
  "global": {
    "color": {
      "brand": {
        "primary": { "$type": "color", "$value": "#ef2da8" },
        "primary-dark": { "$type": "color", "$value": "#c21f88" },
        "ink": { "$type": "color", "$value": "#0d0814" }
      },
      "grey": {
        "50": { "$type": "color", "$value": "#f5f3f7" },
        "200": { "$type": "color", "$value": "#2a1f33" },
        "500": { "$type": "color", "$value": "#8b829a" },
        "800": { "$type": "color", "$value": "#170d1f" },
        "900": { "$type": "color", "$value": "#0d0814" }
      },
      "success": { "500": { "$type": "color", "$value": "#34d399" } },
      "warning": { "500": { "$type": "color", "$value": "#eab308" } },
      "danger": { "500": { "$type": "color", "$value": "#f87171" } },
      "white": { "$type": "color", "$value": "#ffffff" },
      "phase": {
        "concept": { "$type": "color", "$value": "#a78bfa" },
        "world-bible": { "$type": "color", "$value": "#60a5fa" },
        "character-vault": { "$type": "color", "$value": "#34d399" },
        "synopsis": { "$type": "color", "$value": "#eab308" },
        "treatment": { "$type": "color", "$value": "#f472b6" },
        "outline": { "$type": "color", "$value": "#fb923c" },
        "first-draft": { "$type": "color", "$value": "#22d3ee" },
        "revision": { "$type": "color", "$value": "#a78bfa" },
        "final-draft": { "$type": "color", "$value": "#34d399" }
      }
    },
    "space": {
      "2": { "$type": "spacing", "$value": "8" },
      "4": { "$type": "spacing", "$value": "16" },
      "6": { "$type": "spacing", "$value": "24" },
      "8": { "$type": "spacing", "$value": "32" }
    },
    "radius": {
      "sm": { "$type": "borderRadius", "$value": "4" },
      "md": { "$type": "borderRadius", "$value": "8" },
      "lg": { "$type": "borderRadius", "$value": "16" },
      "full": { "$type": "borderRadius", "$value": "999" }
    }
  },
  "semantic": {
    "text": {
      "primary": { "$type": "color", "$value": "{color.grey.50}" },
      "secondary": { "$type": "color", "$value": "{color.grey.500}" },
      "inverse": { "$type": "color", "$value": "{color.brand.ink}" }
    },
    "surface": {
      "default": { "$type": "color", "$value": "{color.grey.800}" },
      "muted": { "$type": "color", "$value": "{color.grey.900}" },
      "border": { "$type": "color", "$value": "{color.grey.200}" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{color.brand.primary}" },
      "primary-hover": { "$type": "color", "$value": "{color.brand.primary-dark}" }
    },
    "feedback": {
      "success": { "$type": "color", "$value": "{color.success.500}" },
      "warning": { "$type": "color", "$value": "{color.warning.500}" },
      "danger": { "$type": "color", "$value": "{color.danger.500}" }
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": { "$type": "color", "$value": "{action.primary}" },
        "bg-hover": { "$type": "color", "$value": "{action.primary-hover}" },
        "fg": { "$type": "color", "$value": "{color.white}" },
        "radius": { "$type": "borderRadius", "$value": "{radius.md}" }
      }
    },
    "badge": {
      "success": {
        "bg": { "$type": "color", "$value": "{feedback.success}" },
        "fg": { "$type": "color", "$value": "{text.inverse}" }
      },
      "warning": {
        "bg": { "$type": "color", "$value": "{feedback.warning}" },
        "fg": { "$type": "color", "$value": "{text.inverse}" }
      },
      "danger": {
        "bg": { "$type": "color", "$value": "{feedback.danger}" },
        "fg": { "$type": "color", "$value": "{text.inverse}" }
      }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{surface.default}" },
      "border": { "$type": "color", "$value": "{surface.border}" },
      "radius": { "$type": "borderRadius", "$value": "{radius.lg}" }
    },
    "phaseTag": {
      "concept": { "bg": { "$type": "color", "$value": "{color.phase.concept}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "world-bible": { "bg": { "$type": "color", "$value": "{color.phase.world-bible}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "character-vault": { "bg": { "$type": "color", "$value": "{color.phase.character-vault}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "synopsis": { "bg": { "$type": "color", "$value": "{color.phase.synopsis}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "treatment": { "bg": { "$type": "color", "$value": "{color.phase.treatment}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "outline": { "bg": { "$type": "color", "$value": "{color.phase.outline}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "first-draft": { "bg": { "$type": "color", "$value": "{color.phase.first-draft}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "revision": { "bg": { "$type": "color", "$value": "{color.phase.revision}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "final-draft": { "bg": { "$type": "color", "$value": "{color.phase.final-draft}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } }
    },
    "stateBadge": {
      "prompting": { "bg": { "$type": "color", "$value": "{action.primary}" }, "fg": { "$type": "color", "$value": "{color.white}" } },
      "processing": { "bg": { "$type": "color", "$value": "{feedback.warning}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "previewing": { "bg": { "$type": "color", "$value": "{surface.border}" }, "fg": { "$type": "color", "$value": "{text.primary}" } },
      "comparing": { "bg": { "$type": "color", "$value": "{color.phase.concept}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "regenerating": { "bg": { "$type": "color", "$value": "{color.phase.world-bible}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "approving": { "bg": { "$type": "color", "$value": "{feedback.success}" }, "fg": { "$type": "color", "$value": "{text.inverse}" } },
      "error-recovery": { "bg": { "$type": "color", "$value": "{feedback.danger}" }, "fg": { "$type": "color", "$value": "{color.white}" } }
    }
  },
  "$metadata": {
    "tokenSetOrder": ["global", "semantic", "component"]
  },
  "$themes": [
    {
      "id": "scriptoplay-default",
      "name": "Default",
      "selectedTokenSets": {
        "global": "source",
        "semantic": "enabled",
        "component": "enabled"
      }
    }
  ]
}
